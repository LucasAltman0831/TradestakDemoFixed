NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only Stripe test-mode credentials. Never prefix these with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_BUILDER_PRO_PRICE_ID=price_...
STRIPE_SUPPLIER_VERIFIED_PRICE_ID=price_...
STRIPE_SUPPLIER_PREMIUM_PRICE_ID=price_...

# Optional demo provisioning. Keep passwords server-side.
DEMO_BUILDER_EMAIL=builder-demo@example.com
DEMO_BUILDER_PASSWORD=replace-with-a-strong-demo-password
DEMO_SUPPLIER_EMAIL=supplier-demo@example.com
DEMO_SUPPLIER_PASSWORD=replace-with-a-strong-demo-password
